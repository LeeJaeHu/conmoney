# conmoney 서버 설정 예시. 이 파일을 server/.env로 복사해 값을 채운다.
# server/.env는 .gitignore로 git에 올라가지 않는다(두 노트북 사이는 직접 복사).

# 앱 ↔ 서버 공유 토큰(Spec 5장). 앱 빌드 설정에도 같은 값을 넣는다.
APP_TOKEN=

# ---- OpenAI (2단계: 구매 상담·분석 / 1단계 대비책)
OPENAI_API_KEY=
# 구매 상담·분석(F6). 함수 호출 + 숫자 검증 재생성까지 감안한 균형형
OPENAI_MODEL_AGENT=gpt-6.1-sol
OPENAI_REASONING_AGENT=low
# 가벼운 작업: jev 실패 시 가맹점 분류, 질문 종류 파악
OPENAI_MODEL_LIGHT=gpt-6-luna
OPENAI_REASONING_LIGHT=none

# ---- jev (1단계: 카테고리 분류, 확신도)
JEV_API_KEY=
# https://docs.typesafe.ai/introduction/quickstart — POST {JEV_BASE_URL}/v1/systemone
JEV_BASE_URL=https://api.typesafe.ai
JEV_MODEL=jev-latest
# 이 값보다 확신도가 낮으면 확인 알림에서 [수정]을 먼저 보여준다(Spec F3)
JEV_MIN_CONFIDENCE=0.8

# ---- 비용 상한(Spec 5장)
MONTHLY_BUDGET_KRW=10000
USD_KRW=1400

# 1이면 요청·응답 본문을 로그에 남긴다(개발 중에만)
DEBUG=0
